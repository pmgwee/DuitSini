# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data source: "mock" (default, no setup) or "supabase"
NEXT_PUBLIC_DATA_SOURCE=mock

# --- Supabase (only needed when NEXT_PUBLIC_DATA_SOURCE=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- YouTube music widget ---
# API key for search (server-only). Google Cloud → APIs → YouTube Data API v3.
YOUTUBE_API_KEY=
# Same OAuth client as configured in Supabase Auth → Providers → Google.
# Needed server-side to refresh the user's YouTube access token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Claude usage live bridge (personal, optional) ---
# Shared secret the local companion (companion/) authenticates with. Must match
# BRIDGE_SECRET in companion/.env. Generate: openssl rand -hex 24
CLAUDE_BRIDGE_SECRET=
# Your Supabase user id — pins pushed usage to your account (recommended).
CLAUDE_BRIDGE_USER_ID=

# --- Telegram integration ---
# From @BotFather (/newbot). Server-only; powers sendMessage + the webhook.
TELEGRAM_BOT_TOKEN=
# Bot username WITHOUT the leading @, used to build the dashboard connect link
# (https://t.me/<USERNAME>?start=<code>). From BotFather.
TELEGRAM_BOT_USERNAME=
# Used two ways: (a) the HMAC key for the stateless connect-link code, and
# (b) verified as the `x-telegram-bot-api-secret-token` webhook header. Generate:
# openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# --- Reminders cron ---
# Secret authorizing the daily reminders sweep. Vercel Cron injects it as the
# `Authorization: Bearer <CRON_SECRET>` header; the route 401s without it.
# Generate: openssl rand -hex 24
CRON_SECRET=

# --- Reports cron (phase 4) ---
# Optional. Your own Telegram chat id — when set, the reports sweep pages you on
# failure (a sweep that threw, or reported failed/truncated deliveries). Silent
# when unset. Find your chat id by messaging the bot, then reading getUpdates.
# OPS_ALERT_TELEGRAM_CHAT_ID=

# --- Send report to Telegram as PDF (phase 4) ---
# Serverless Chromium (@sparticuz/chromium-min) ships no binary (chromium.br is
# >50MB, over Vercel's function limit). Host the pack ONCE and point to it:
#   1. Download chromium-vXXX-pack.tar from https://github.com/Sparticuz/chromium/releases
#      (match the @sparticuz/chromium-min major — currently v149).
#   2. Upload it to S3 / Vercel Blob / a GitHub release asset (any fast HTTPS URL).
#   3. Set CHROMIUM_PACK_URL to that URL. First call downloads+caches it in /tmp.
# CHROMIUM_PACK_URL=https://example.com/chromium-v149-pack.tar
# Local dev only: point at a system Chrome instead of the hosted pack.
# CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# --- WhatsApp Cloud API (phase 2) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Serenity tracker (/serenity) ---
# Live trailing-1-year % on the Opportunity Radar dip stocks is sourced from
# Yahoo Finance's public chart endpoint — NO key needed (cached 1 day). It degrades
# gracefully to the static "since tracked" return if Yahoo rate-limits a request.
# (FMP's free tier no longer covers this; no env var required — FMP_API_KEY, if set,
# is simply unused.)
#
# Freshness pipeline (three layers, each a fallback for the one above):
#   1. /api/cron/serenity — every 10 min, purges the `serenity-feed` cache tag and
#      re-reads so the X feed is warm even under zero traffic. Auth: CRON_SECRET
#      (above), same bearer as the reminders/reports crons.
#   2. next.revalidate (5 min) on the trackserenity fetch — lazy, visitor-triggered.
#   3. The page's own client poll (3 min, tab-visible only).
# Layers 2+3 alone are enough to keep the page correct; the cron only removes the
# "first visitor after a quiet spell eats a stale read" gap.
#
# HEADS UP — Vercel plan limits: Hobby allows 2 cron jobs, each at most ONCE PER DAY.
# This repo now declares 3 (reminders, reports, serenity) and serenity runs */10, so
# on Hobby the deploy will reject the schedule. Options:
#   - Pro plan: works as declared, no change needed.
#   - Stay on Hobby: drop the serenity entry from vercel.json and drive the warm from
#     an EXTERNAL scheduler instead — any of cron-job.org / GitHub Actions / UptimeRobot
#     hitting the route on the same 10-min cadence:
#       curl -H "Authorization: Bearer $CRON_SECRET" https://<your-domain>/api/cron/serenity
#     The route is plain authed GET, so it doesn't care what invokes it.
